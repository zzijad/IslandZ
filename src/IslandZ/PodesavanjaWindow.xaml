<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IslandZ.PodesavanjaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Koren" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,24,28,28" Spacing="10" MaxWidth="560">

                <TextBlock Text="Izgled" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,2" />
                <ComboBox x:Name="Stil" Header="Stil" HorizontalAlignment="Stretch" SelectionChanged="Promena_Izbor">
                    <ComboBoxItem Content="Staklo" />
                    <ComboBoxItem Content="Crno" />
                </ComboBox>
                <Slider x:Name="Velicina" Header="Veličina (%)" Minimum="80" Maximum="140" StepFrequency="5" ValueChanged="Promena_Klizac" />
                <Slider x:Name="Providnost" Header="Providnost stakla" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Promena_Klizac" />

                <TextBlock Text="Ponašanje" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,2" />
                <ComboBox x:Name="Otvaranje" Header="Otvaranje" HorizontalAlignment="Stretch" SelectionChanged="Promena_Izbor">
                    <ComboBoxItem Content="Kad kursor priđe" />
                    <ComboBoxItem Content="Na klik" />
                </ComboBox>
                <Slider x:Name="Zadrska" Header="Zadrška pre otvaranja (ms)" Minimum="0" Maximum="1000" StepFrequency="50" ValueChanged="Promena_Klizac" />
                <ComboBox x:Name="Monitor" Header="Monitor" HorizontalAlignment="Stretch" SelectionChanged="Promena_Izbor" />
                <ToggleSwitch x:Name="CeoEkran" Header="Sakrij dok je nešto preko celog ekrana" Toggled="Promena_Prekidac" />

                <TextBlock Text="Šta se prikazuje" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,2" />
                <ToggleSwitch x:Name="MuzikaP" Header="Muzika" Toggled="Promena_Prekidac" />
                <ToggleSwitch x:Name="PodsetnikP" Header="Rokovi iz Podsetnika" Toggled="Promena_Prekidac" />
                <ToggleSwitch x:Name="TajmerP" Header="Tajmer" Toggled="Promena_Prekidac" />
                <ToggleSwitch x:Name="TackiceP" Header="Tačkica ispod pokrenutih programa" Toggled="Promena_Prekidac" />

                <TextBlock Text="Sistem" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,2" />
                <ToggleSwitch x:Name="Autostart" Header="Pokreni sa Windowsom" Toggled="Autostart_Toggled" />
                <ComboBox x:Name="Precica" Header="Prečica za otvaranje ostrva" HorizontalAlignment="Stretch" SelectionChanged="Promena_Izbor" />

                <TextBlock Text="Programi se kače prevlačenjem prečice na ostrvo ili dugmetom +, a uklanjaju desnim klikom."
                           TextWrapping="Wrap" Opacity="0.8" Margin="0,12,0,0" />
                <TextBlock x:Name="Verzija" Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
