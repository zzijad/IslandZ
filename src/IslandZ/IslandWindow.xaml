<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IslandZ.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Koren" RequestedTheme="Dark" Background="Transparent" AllowDrop="True"
          DragOver="Koren_DragOver" Drop="Koren_Drop" KeyDown="Koren_KeyDown" SizeChanged="Koren_SizeChanged">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="Meni" Opened="Meni_Opened" Closed="Meni_Closed">
                <MenuFlyoutItem Text="Podešavanja" Click="Podesavanja_Click" />
                <MenuFlyoutItem Text="Izlaz" Click="Izlaz_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid x:Name="StakloDomacin" IsHitTestVisible="False" />
        <Border x:Name="Okvir" BorderThickness="1" BorderBrush="#66FFFFFF" IsHitTestVisible="False" />

        <Canvas x:Name="Platno">
            <Grid x:Name="Sadrzaj">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="Skala" />
                </Grid.RenderTransform>

                <!-- Mirovanje: mala pilula -->
                <StackPanel x:Name="PilulaPanel" Orientation="Horizontal" Height="40" Spacing="14"
                            Padding="12,0,16,0" Background="Transparent" PointerPressed="Pilula_PointerPressed">
                    <StackPanel x:Name="MiniIkone" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                    <StackPanel x:Name="PilulaMuzika" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xEC4F;" FontSize="14" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="3" Height="18" VerticalAlignment="Center">
                            <Rectangle x:Name="Traka1" Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="Traka2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="Traka3" Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="Traka4" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PilulaTajmer" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="#FFB340" VerticalAlignment="Center" />
                        <TextBlock x:Name="PilulaTajmerTekst" FontSize="14" FontWeight="SemiBold" Foreground="#FFB340" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PilulaSat" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Rasireno: pokretac -->
                <StackPanel x:Name="RasirenoPanel" Width="600" Padding="24,12,24,22" Spacing="14" Visibility="Collapsed">
                    <Grid Height="36">
                        <TextBlock x:Name="Sat" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="Datum" FontSize="14" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Click="Dodaj_Click" ToolTipService.ToolTip="Zakači program" Width="36" Height="36" Padding="0"
                                    Background="Transparent" BorderThickness="0" CornerRadius="18">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Click="Podesavanja_Click" ToolTipService.ToolTip="Podešavanja" Width="36" Height="36" Padding="0"
                                    Background="Transparent" BorderThickness="0" CornerRadius="18">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="Pretraga" PlaceholderText="Pretraži programe" Height="40" CornerRadius="20"
                             Padding="16,9,16,0" TextChanged="Pretraga_TextChanged" KeyDown="Pretraga_KeyDown" />

                    <StackPanel x:Name="ProgramiPanel" Spacing="4" />
                    <TextBlock x:Name="PrazanTekst" Text="Prevuci prečicu programa ovde ili klikni + da je zakačiš."
                               Opacity="0.85" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="Collapsed" />

                    <Border x:Name="MuzikaPlocica" Background="#24FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                            CornerRadius="24" Padding="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="13" Background="#D6409F">
                                <Grid>
                                    <FontIcon Glyph="&#xEC4F;" FontSize="20" />
                                    <Image x:Name="MuzikaSlika" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="MuzikaNaslov" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MuzikaIzvodjac" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Click="Prethodna_Click" ToolTipService.ToolTip="Prethodna" Width="40" Height="40" Padding="0"
                                        Background="Transparent" BorderThickness="0" CornerRadius="20">
                                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                                </Button>
                                <Button Click="Pusti_Click" ToolTipService.ToolTip="Pusti / pauziraj" Width="44" Height="44" Padding="0"
                                        Background="#33FFFFFF" BorderThickness="0" CornerRadius="22">
                                    <FontIcon x:Name="PustiIkona" Glyph="&#xE768;" FontSize="16" />
                                </Button>
                                <Button Click="Sledeca_Click" ToolTipService.ToolTip="Sledeća" Width="40" Height="40" Padding="0"
                                        Background="Transparent" BorderThickness="0" CornerRadius="20">
                                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="DonjiRed" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="RokPlocica" Background="#24FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                CornerRadius="24" Padding="14" Tapped="Rok_Tapped">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="13" Background="#E5484D">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="RokNaslov" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="RokTekst" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="TajmerPlocica" Grid.Column="1" Background="#24FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                CornerRadius="24" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="13" Background="#B86A00">
                                    <FontIcon Glyph="&#xE916;" FontSize="18" />
                                </Border>
                                <StackPanel x:Name="TajmerUnos" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBox x:Name="TajmerMinuti" Text="15" Width="64" MinWidth="64" KeyDown="TajmerMinuti_KeyDown" />
                                    <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.85" />
                                </StackPanel>
                                <TextBlock x:Name="TajmerPreostalo" Grid.Column="1" FontSize="20" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <Button x:Name="TajmerDugme" Grid.Column="2" Content="Pokreni" Click="TajmerDugme_Click"
                                        Height="40" CornerRadius="20" Padding="14,0,14,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Obavestenje -->
                <Grid x:Name="ObavestenjePanel" Width="470" Height="80" Padding="16,0,16,0" ColumnSpacing="14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ObavKutija" Width="48" Height="48" CornerRadius="14" Background="#E5484D" VerticalAlignment="Center">
                        <FontIcon x:Name="ObavIkona" Glyph="&#xEA8F;" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ObavNaslov" FontSize="12" Opacity="0.85" />
                        <TextBlock x:Name="ObavTekst" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="ObavDugme" Grid.Column="2" Content="Otvori" Click="ObavDugme_Click"
                            Height="40" CornerRadius="20" Padding="16,0,16,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
